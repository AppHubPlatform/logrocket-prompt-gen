.terraform/
# .terraform.lock.hcl is intentionally NOT ignored: it's committed so every
# machine and any future CI resolves the same provider versions.
# State lives in GCS (see versions.tf); these patterns are a safety net for
# stray local state files.
*.tfstate
*.tfstate.*
crash.log
crash.*.log
terraform.tfvars
*.auto.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
